// TUSAM v3.0
// ============================================================
class TUSAMv3 {
  constructor(initCapital=1000){
    this.ensemble = new EnsembleMLP(14, 8);
    this.buffer = new ReplayBuffer(CFG.bufferSize);
    this.elo = new ELORanker(1500);
    this.journal = [];
    this.capital = initCapital;
    this.equity = [initCapital];
    this.versions = {
      ai: {wins:[], trades:0},
      momentum: {wins:[], trades:0},
      pattern: {wins:[], trades:0}
    };
    this.useVersion = 'ai';
    this.confThr = 0.12;
    this.mfeMulti = 1.5;
    this.slMulti = 1.5;
    this.open = null;
    this.totalTrades = 0;
    this.trainBatches = 0;
    this.lastLoss = null;
    this.lastPrediction = null;
    this.regimeCount = {};
  }
  predict(sig, k5, dltp, regime){
    if(!k5 || k5.length < 30) return null;
    const feat = featurize(sig, k5, regime);
    const ens = this.ensemble.predict(feat);
    this.lastPrediction = {feat, ens, regime};
    if(ens.uncertainty > CFG.uncertaintyThr) return null;
    if(ens.agreement < CFG.minAgreement) return null;
    let sel = this.useVersion, out;
    if(sel === 'ai'){
      if(Math.abs(ens.mean - 0.5) < this.confThr) return null;
      const dir = ens.mean > 0.5 ? 1 : -1;
      out = {dir, conf: Math.abs(ens.mean - 0.5)*2, feat, regime};
    } else if(sel === 'momentum'){
      const ema10 = EMA(k5.map(k=>k.c), 10);
      if(!ema10) return null;
      const slope = (ema10[ema10.length-1] - ema10[Math.max(0,ema10.length-4)]) / ema10[Math.max(0,ema10.length-4)];
      if(regime === 'RANGE' && Math.abs(slope) < 0.004) return null;
      if(Math.abs(slope) < 0.0015) return null;
      out = {dir: slope>0?1:-1, conf: Math.min(0.5, Math.abs(slope)*100), feat, regime};
    } else {
      if(!sig || sig.dir === 0) return null;
      const patternBoost = regime === 'RANGE' ? 1.2 : 1.0;
      out = {dir: sig.dir, conf: Math.min(0.5, (sig.score/10)*patternBoost), feat, regime};
    }
    if(!out || !out.dir) return null;
    let A = ATR(k5, 14);
    if(!A || A <= 0) A = k5[k5.length-1].c * 0.01;
    const entry = k5[k5.length-1].c;
    const sl = out.dir===1 ? entry - A*this.slMulti : entry + A*this.slMulti;
    const tp1 = out.dir===1 ? entry + A*this.mfeMulti*1.2 : entry - A*this.mfeMulti*1.2;
    const tp2 = out.dir===1 ? entry + A*this.mfeMulti*2.4 : entry - A*this.mfeMulti*2.4;
    return {dir: out.dir, score: Math.max(3, Math.round(out.conf*12)), entry, sl, tp1, tp2, version: sel, conf: out.conf, regime, uncertainty: ens.uncertainty, agreement: ens.agreement, feat};
  }
  tick(sym, price){
    const t = this.open;
    if(!t || t.sym !== sym) return;
    if(t.dir === 1){t.mfe = Math.max(t.mfe||0, price-t.entry); t.mae = Math.min(t.mae||0, price-t.entry);}
    else{t.mfe = Math.max(t.mfe||0, t.entry-price); t.mae = Math.min(t.mae||0, t.entry-price);}
  }
  onClose(closePrice, posOverride){
    const t = posOverride || this.open;
    if(!t) return null;
    const pnl = (closePrice - t.entry) * (t.dir===1?1:-1);
    const pnlPct = t.entry > 0 ? (pnl/t.entry*100) : 0;
    const mfe = t.mfe||0, mae = t.mae||0;
    const slDist = Math.abs(t.entry - t.sl) || 1;
    const R = pnl/slDist;
    const label = pnl > 0 ? 1 : 0;
    const reward = Math.max(-2, Math.min(3, R)) * 1.5;
    const feat = t.feat || (t.evoSnapshot ? t.evoSnapshot.feat : new Array(14).fill(0));
    
    this.buffer.add({feat, label, reward, R, version:t.version, regime:t.regime, ts:Date.now()});
    if(this.buffer.buf.length >= CFG.batchSize){
      const batch = this.buffer.sample(CFG.batchSize);
      let totalLoss = 0;
      batch.forEach(exp => {
        const w = 1 + Math.min(1, Math.abs(exp.reward)/3);
        totalLoss += this.ensemble.train(exp.feat, exp.label, w);
      });
      this.trainBatches++;
      this.lastLoss = totalLoss/batch.length;
    } else {
      this.ensemble.train(feat, label, 1);
    }
    const v = this.versions[t.version];
    if(v){v.wins.push(label); v.trades++; if(v.wins.length>100)v.wins.shift();}
    if(!this.regimeCount[t.regime]) this.regimeCount[t.regime] = {n:0, w:0};
    this.regimeCount[t.regime].n++;
    if(label === 1) this.regimeCount[t.regime].w++;
    const target1 = Math.abs(t.tp1 - t.entry)||1;
    const target2 = Math.abs(t.tp2 - t.entry)||1;
    if(mfe>0 && (mfe/target1)<0.8) this.mfeMulti *= 0.97;
    else if(mfe>0 && (mfe/target2)>1.3) this.mfeMulti *= 1.03;
    this.mfeMulti = Math.max(0.5, Math.min(5, this.mfeMulti));
    if(mae && mae<0 && pnl<0) this.slMulti *= 0.96;
    else if(pnl>0 && mae > -target1*0.2) this.slMulti *= 1.02;
    this.slMulti = Math.max(0.5, Math.min(5, this.slMulti));
    this.elo.update(t.version, label === 1);
    const oldV = this.useVersion;
    this.useVersion = this.elo.best();
    const recentWins = this.journal.slice(-30).map(j=>j.label);
    const rollingWr = recentWins.length ? recentWins.reduce((a,b)=>a+b,0)/recentWins.length : 0.5;
    if(rollingWr < 0.4 && recentWins.length >= 20) this.confThr = Math.min(0.35, this.confThr*1.05);
    else if(rollingWr > 0.65 && recentWins.length >= 20) this.confThr = Math.max(0.05, this.confThr*0.98);
    this.capital *= (1 + pnlPct/100);
    this.equity.push(this.capital);
    if(this.equity.length > 500) this.equity.shift();
    this.totalTrades++;
    this.journal.push({sym:t.sym, pnlPct:+pnlPct.toFixed(3), R:+R.toFixed(2), label, version:t.version, regime:t.regime, mfe:+mfe.toFixed(4), mae:+mae.toFixed(4), unc:t.ens?+t.ens.uncertainty.toFixed(3):0, ts:Date.now()});
    if(this.journal.length > 200) this.journal.shift();
    this.open = null;
    return {useVersion:this.useVersion, changed:oldV !== this.useVersion, capital:this.capital, mfeMulti:this.mfeMulti, slMulti:this.slMulti, confThr:this.confThr, elo:this.elo.elo, R};
  }
  getStats(){
    const stat = vv => {
      const w = this.versions[vv].wins;
      if(!w.length) return {wr:0,n:0};
      return {wr:w.reduce((a,b)=>a+b,0)/w.length, n:w.length};
    };
    return {
      ai: stat('ai'), momentum: stat('momentum'), pattern: stat('pattern'),
      active: this.useVersion, capital: this.capital, trades: this.totalTrades,
      mfeMulti: this.mfeMulti, slMulti: this.slMulti, confThr: this.confThr,
      equity: this.equity, journal: this.journal,
      elo: this.elo.elo, eloMatches: this.elo.matches,
      buffer: this.buffer.stats(), trainBatches: this.trainBatches, lastLoss: this.lastLoss,
      lastPrediction: this.lastPrediction, regimeCount: this.regimeCount
    };
  }
  serialize(){
    return {
      ensemble: this.ensemble.serialize(), buffer: this.buffer.serialize(), elo: this.elo.serialize(),
      capital: this.capital, equity: this.equity.slice(-200),
      versions: {
        ai:{wins:this.versions.ai.wins.slice(-100), trades:this.versions.ai.trades},
        momentum:{wins:this.versions.momentum.wins.slice(-100), trades:this.versions.momentum.trades},
        pattern:{wins:this.versions.pattern.wins.slice(-100), trades:this.versions.pattern.trades},
      },
      useVersion: this.useVersion, confThr: this.confThr, mfeMulti: this.mfeMulti, slMulti: this.slMulti,
      journal: this.journal.slice(-100), totalTrades: this.totalTrades, trainBatches: this.trainBatches,
      regimeCount: this.regimeCount,
    };
  }
  loadState(d){
    if(!d) return;
    try{
      this.ensemble.loadState(d.ensemble); this.buffer.loadState(d.buffer); this.elo.loadState(d.elo);
      this.capital = d.capital||1000; this.equity = d.equity||[1000];
      if(d.versions){
        this.versions.ai.wins = d.versions.ai?.wins||[];
        this.versions.momentum.wins = d.versions.momentum?.wins||[];
        this.versions.pattern.wins = d.versions.pattern?.wins||[];
        this.versions.ai.trades = d.versions.ai?.trades||0;
        this.versions.momentum.trades = d.versions.momentum?.trades||0;
        this.versions.pattern.trades = d.versions.pattern?.trades||0;
      }
      this.useVersion = d.useVersion||'ai';
      this.confThr = d.confThr ?? 0.12;
      this.mfeMulti = d.mfeMulti ?? 1.5;
      this.slMulti = d.slMulti ?? 1.5;
      this.journal = d.journal||[];
      this.totalTrades = d.totalTrades||0;
      this.trainBatches = d.trainBatches||0;
      this.regimeCount = d.regimeCount||{};
    }catch(e){console.warn('loadState v3 err', e);}
  }
}

