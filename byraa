function simK(sym,tf,limit){
  const out=[];
  const seed=(sym||'BTC').split('').reduce((a,c)=>a+c.charCodeAt(0),0);
  let base=100+(seed%500);
  if(sym.includes('BTC'))base=68000;else if(sym.includes('ETH'))base=3500;else if(sym.includes('SOL'))base=185;else if(sym.includes('BNB'))base=590;
  let now=Date.now()-limit*5*60*1000;
  for(let i=0;i<limit;i++){
    const vol=base*0.004;
    const ch=(Math.random()-0.49)*vol;
    const o=base,c=base+ch;
    const h=Math.max(o,c)+Math.random()*vol*0.6;
    const l=Math.min(o,c)-Math.random()*vol*0.6;
    const v=100+Math.random()*500+(Math.random()<0.15?800:0);
    out.push({t:now+i*5*60*1000,o,h,l,c,v});
    base=c;
  }
  return out;
}
async function fetchK(sym,tf,limit){
  if(useSim) return simK(sym,tf,limit);
  const iv=TF_MAP[tf]||tf;
  try{
    const ctrl=new AbortController();
    const tid=setTimeout(()=>ctrl.abort(),3500);
    const url=BINANCE+'/fapi/v1/klines?symbol='+sym+'&interval='+iv+'&limit='+limit;
    const res=await fetch(url,{signal:ctrl.signal});
    clearTimeout(tid);
    if(res.ok){const data=await res.json();if(Array.isArray(data)&&data.length>0)return data.map(r=>({t:+r[0],o:+r[1],h:+r[2],l:+r[3],c:+r[4],v:+r[5]}));}
  }catch(e){}
  return simK(sym,tf,limit);
}
