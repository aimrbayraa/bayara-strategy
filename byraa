  if($('evoM2'))$('evoM2').textContent=stats.trades;
  if($('evoM3'))$('evoM3').textContent=stats.mfeMulti.toFixed(2);
  if($('evoM4'))$('evoM4').textContent=stats.slMulti.toFixed(2);
