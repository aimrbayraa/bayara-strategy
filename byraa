  for(let i=0;i<CFG.batch;i++){
    if(scanIdx>=scanQueue.length){scanIdx=0;cycles++;if($('cycleCount'))$('cycleCount').textContent=cycles;}
    const c=scanQueue[scanIdx++];
    if(c) batch.push(c);
  }
  await Promise.all(batch.map(c=>scanOne(c)));
  const elapsed=Date.now()-lastStart;
  if($('cycleTime'))$('cycleTime').textContent=elapsed+'ms';
  if($('scanStatus'))$('scanStatus').textContent='active';
  scanning=false;
