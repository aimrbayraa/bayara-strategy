<!DOCTYPE html>
<html lang="mn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEXUS TUSAM v3.0 — Auto-Optimize Best Saver</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://s3.tradingview.com/tv.js"></script>
<style>
  body { background: #08050f; color: #ede9fe; font-family: system-ui, -apple-system, sans-serif; }
  .glass { background: rgba(22, 15, 42, 0.88); backdrop-filter: blur(18px); border: 1px solid rgba(168, 85, 247, 0.20); }
  .inner { background: rgba(15, 10, 32, 0.72); border: 1px solid rgba(168, 85, 247, 0.14); }
  .grad { background: linear-gradient(135deg, #a855f7, #22d3ee); color: #08050f; font-weight: 800; }
  .grad:hover { filter: brightness(1.1); }
  .badge { display: inline-flex; align-items: center; padding: 1px 6px; border-radius: 4px; font-size: 10px; font-weight: 600; }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.35); border-radius: 3px; }
  .val-pos { color: #0ecb81; } .val-neg { color: #f6465d; }
  .scanning-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #22d3ee; animation: sd 1s infinite; }
  @keyframes sd { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }
  select { appearance: none; }
  .tab-btn { transition: all 0.2s; border-bottom: 2px solid transparent; }
  .tab-btn.active { border-color: #22d3ee; color: #22d3ee; background: rgba(34, 211, 238, 0.06); }
  #tv_chart_container { height: 100%; width: 100%; position: relative; background: #0a0618; }
  #tv_chart_container iframe { width: 100%; height: 100%; border: none; display: block; }
  .bot-active { animation: pulse-red 2s infinite; }
  @keyframes pulse-red { 0%,100% { box-shadow: 0 0 0 rgba(225,29,72,0); } 50% { box-shadow: 0 0 25px rgba(225,29,72,0.7); } }
  .score-badge { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 9px; font-weight: 700; }
  .score-full { background: rgba(14,203,129,0.25); color: #0ecb81; }
  .score-miss { background: rgba(100,100,100,0.2); color: #666; }
  .hidden { display: none !important; }
  .status-scanning { color: #22d3ee; animation: sd 0.6s infinite; }
  .status-signal { color: #0ecb81; font-weight: 700; }
  .status-filtered { color: #f0b90b; }
  .status-wait { color: #666; }
  .scan-row:hover { background: rgba(168,85,247,0.1); cursor: pointer; }
  .scan-row.active { background: rgba(34,211,238,0.12); border-left: 2px solid #22d3ee; }
  .version-tag { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 9px; font-weight: 700; }
  .v-ai { background: rgba(168,85,247,0.2); color: #a855f7; }
  .v-momentum { background: rgba(34,211,238,0.2); color: #22d3ee; }
  .v-pattern { background: rgba(14,203,129,0.2); color: #0ecb81; }
  .regime-tag { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 8px; font-weight: 700; }
  .reg-trend-up { background: rgba(14,203,129,0.2); color: #0ecb81; }
  .reg-trend-down { background: rgba(246,70,93,0.2); color: #f6465d; }
  .reg-range { background: rgba(168,85,247,0.2); color: #a855f7; }
  .reg-volatile { background: rgba(240,185,11,0.25); color: #f0b90b; }
  .reg-quiet { background: rgba(120,120,120,0.2); color: #888; }
  .elo-bar { height: 3px; background: linear-gradient(90deg, #22d3ee, #a855f7); border-radius: 2px; }
  .best-glow { animation: best-pulse 2s infinite; }
  @keyframes best-pulse { 0%,100% { box-shadow: 0 0 5px rgba(255,215,0,0.3); } 50% { box-shadow: 0 0 25px rgba(255,215,0,0.8); } }
  .progress-bar { height: 4px; background: rgba(15,10,32,0.9); border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, #a855f7, #22d3ee); transition: width 0.5s; }
  .best-badge { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #08050f; font-weight: 900; padding: 2px 8px; border-radius: 4px; font-size: 9px; }
</style>
</head>
<body class="p-2 max-w-[1700px] mx-auto min-h-screen flex flex-col justify-between">

<div>
<header class="glass rounded-2xl p-3 mb-2 flex flex-wrap justify-between gap-2 items-center">
  <div class="flex items-center gap-2 flex-wrap">
    <div class="grad px-4 py-2 rounded-xl text-sm tracking-wider flex items-center gap-2">
      <i class="fa-solid fa-dna"></i> NEXUS TUSAM v3.0
    </div>
    <div class="inner px-2.5 py-1.5 rounded-lg flex items-center gap-2 text-[10px]">
      <span class="scanning-dot"></span>
      <span class="text-emerald-300" id="feedStatus">READY</span>
    </div>
    <div class="inner px-2.5 py-1.5 rounded-lg text-[10px]"><span class="text-gray-500">REGIME</span> <b id="regimeVal" class="text-cyan-300">—</b></div>
    <div class="inner px-2.5 py-1.5 rounded-lg text-[10px]"><span class="text-gray-500">VERSION</span> <b id="versionVal" class="text-purple-300">—</b></div>
    <div class="inner px-2.5 py-1.5 rounded-lg text-[10px]"><span class="text-gray-500">ELO</span> <b id="eloVal" class="text-amber-300">—</b></div>
    <div class="inner px-2.5 py-1.5 rounded-lg text-[10px]"><span class="text-gray-500">BEST</span> <b id="bestScoreVal" class="text-yellow-300">—</b></div>
    <div class="inner px-2.5 py-1.5 rounded-lg text-[10px]"><span class="text-gray-500">NEXT EVAL</span> <b id="nextEvalVal" class="text-fuchsia-300">—</b></div>
  </div>
  <div class="flex flex-wrap gap-2 items-center text-[11px]">
    <div class="inner px-2.5 py-1.5 rounded-lg"><span class="text-gray-400 text-[9px]">BAL</span> <span id="balVal" class="font-bold text-white">$1,000</span></div>
    <div class="inner px-2.5 py-1.5 rounded-lg"><span class="text-gray-400 text-[9px]">PNL</span> <span id="pnlVal" class="font-bold">$0.00</span></div>
    <div class="inner px-2.5 py-1.5 rounded-lg"><span class="text-gray-400 text-[9px]">WR</span> <span id="wrVal" class="font-bold text-purple-300">—</span></div>
    <div class="inner px-2.5 py-1.5 rounded-lg"><span class="text-gray-400 text-[9px]">DD</span> <span id="ddVal" class="font-bold text-amber-300">0%</span></div>
  </div>
</header>

<nav class="glass rounded-2xl p-1 mb-2 flex flex-wrap gap-1 text-[11px]">
  <button id="tab-live" class="tab-btn active px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-wave-square"></i> LIVE</button>
  <button id="tab-backtest" class="tab-btn px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-flask"></i> BACKTEST</button>
  <button id="tab-analytics" class="tab-btn px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-chart-pie"></i> ANALYTICS</button>
  <button id="tab-evolution" class="tab-btn px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-dna"></i> TUSAM</button>
  <button id="tab-brain" class="tab-btn px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-brain"></i> BRAIN</button>
  <button id="tab-optimizer" class="tab-btn px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-trophy"></i> BEST</button>
  <button id="tab-checklist" class="tab-btn px-3 py-2 rounded-lg font-semibold flex-1 min-w-[70px]"><i class="fa-solid fa-list-check"></i> CHECK</button>
</nav>

<!-- LIVE TAB -->
<div id="tab-content-live">
  <div class="glass rounded-2xl p-3 mb-2 flex flex-wrap items-center gap-3">
    <button id="botBtn" class="grad px-6 py-3 rounded-xl text-base font-bold flex items-center gap-2">
      <i class="fa-solid fa-play"></i> <span id="botBtnTxt">AI БОТ ЭХЛҮҮЛЭХ</span>
    </button>
    <button id="liveBtn" class="bg-emerald-700/80 hover:bg-emerald-600 text-white px-3 py-3 rounded-xl text-[11px] font-semibold flex items-center gap-1.5 transition">
      <i class="fa-solid fa-money-bill-transfer"></i> <span id="liveModeTxt">PAPER</span>
    </button>
    <button id="resetBtn" class="bg-slate-600/80 hover:bg-slate-500 text-white px-3 py-3 rounded-xl text-[11px] font-semibold flex items-center gap-1.5 transition">
      <i class="fa-solid fa-undo"></i> Reset
    </button>
    <div class="flex flex-wrap gap-2 text-[11px] ml-auto">
      <label class="inner rounded-lg px-2 py-1.5 flex items-center gap-1"><span class="text-gray-400">TF</span>
        <select id="tfSel" class="bg-transparent text-purple-300 font-bold outline-none cursor-pointer"><option value="1m">1м</option><option value="3m">3м</option><option value="5m" selected>5м</option></select></label>
      <label class="inner rounded-lg px-2 py-1.5 flex items-center gap-1"><span class="text-gray-400">HTF</span>
        <select id="htfSel" class="bg-transparent text-cyan-300 font-bold outline-none cursor-pointer"><option value="1h">1H</option><option value="4h" selected>4H</option></select></label>
      <label class="inner rounded-lg px-2 py-1.5 flex items-center gap-1"><span class="text-gray-400">Score</span>
        <select id="scoreSel" class="bg-transparent text-amber-300 font-bold outline-none cursor-pointer"><option value="3">3/6</option><option value="4" selected>4/6</option><option value="5">5/6</option></select></label>
      <label class="inner rounded-lg px-2 py-1.5 flex items-center gap-1"><span class="text-gray-400">Risk%</span>
        <select id="riskSel" class="bg-transparent text-fuchsia-300 font-bold outline-none cursor-pointer"><option>0.25</option><option selected>0.5</option><option>0.75</option><option>1</option></select></label>
      <label class="inner rounded-lg px-2 py-1.5 flex items-center gap-1"><span class="text-gray-400">Speed</span>
        <select id="speedSel" class="bg-transparent text-cyan-300 font-bold outline-none cursor-pointer"><option value="slow">🐢</option><option value="normal">⚡</option><option value="fast" selected>🚀</option><option value="turbo">💨</option></select></label>
    </div>
  </div>

  <!-- AUTO-OPT STATUS BAR -->
  <div class="glass rounded-2xl p-2 mb-2 flex flex-wrap items-center gap-3">
    <div class="flex items-center gap-2">
      <i class="fa-solid fa-trophy text-yellow-400"></i>
      <span class="text-[10px] font-bold text-yellow-300">AUTO-OPTIMIZE</span>
      <span id="autoOptBadge" class="best-badge hidden">🏆 BEST SAVED</span>
    </div>
    <div class="flex-1 min-w-[200px]">
      <div class="flex justify-between text-[9px] mb-1">
        <span class="text-gray-500">Next evaluation</span>
        <span id="evalProgressTxt" class="text-cyan-300 font-mono">0/10 trades</span>
      </div>
      <div class="progress-bar"><div id="evalProgressBar" class="progress-fill" style="width:0%"></div></div>
    </div>
    <div class="flex gap-2 text-[10px]">
      <div class="inner rounded px-2 py-1"><span class="text-gray-500">EVALS:</span> <b id="evalCount" class="text-purple-300">0</b></div>
      <div class="inner rounded px-2 py-1"><span class="text-gray-500">IMPROVEMENTS:</span> <b id="bestCount" class="text-yellow-300">0</b></div>
      <button id="forceEvalBtn" class="bg-yellow-600/60 hover:bg-yellow-600 text-white px-2 py-1 rounded text-[10px] font-bold transition">Force Eval</button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-2">
    <div class="lg:col-span-3 glass rounded-2xl p-2.5">
      <div class="flex justify-between items-center mb-1.5"><h3 class="text-[11px] font-bold text-purple-300 uppercase tracking-widest">// SCANNER</h3><span id="scanStatus" class="text-[10px] text-cyan-300 font-mono">idle</span></div>
      <div class="inner rounded-lg p-2 mb-2 text-[10px] grid grid-cols-4 gap-1 text-center font-mono">
        <div><div class="text-gray-500">UNIV</div><b id="pqSize" class="text-cyan-300">0</b></div>
        <div><div class="text-gray-500">CYC</div><b id="cycleCount" class="text-purple-300">0</b></div>
        <div><div class="text-gray-500">SCAN</div><b id="totScanned" class="text-cyan-300">0</b></div>
        <div><div class="text-gray-500">SIG</div><b id="sigCount" class="text-emerald-300">0</b></div>
      </div>
      <div class="inner rounded-lg p-1.5 mb-2 text-[9px] flex justify-between">
        <span class="text-gray-500">Cycle:</span>
        <b id="cycleTime" class="text-emerald-300 font-mono">—</b>
      </div>
      <div class="overflow-auto max-h-[420px] text-[11px]">
        <table class="w-full text-left">
          <thead class="sticky top-0 bg-[#0f0a20] z-10"><tr class="text-purple-400/70 border-b border-purple-500/20 text-[9px] uppercase">
            <th class="pl-1">Sym</th><th>Reg</th><th>V</th><th class="text-right pr-1">Sc</th><th class="text-right pr-1">St</th>
          </tr></thead>
          <tbody id="scanBody"><tr><td colspan="5" class="text-center py-6 text-gray-500">Эхэлж байна...</td></tr></tbody>
        </table>
      </div>
    </div>

    <div class="lg:col-span-6 glass rounded-2xl p-2.5 flex flex-col">
      <div class="flex justify-between items-center mb-1.5 flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <h3 class="text-[11px] font-bold text-cyan-300 uppercase tracking-widest">// LIVE CHART</h3>
          <span id="chartSym" class="badge bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">—</span>
        </div>
        <span id="chartPrice" class="text-sm font-bold text-white font-mono">—</span>
      </div>
      <div id="chartWrap" class="relative bg-[#0a0618] w-full rounded-lg overflow-hidden inner" style="height:440px">
        <div id="tv_chart_container"></div>
        <div class="absolute top-1 left-1 text-[9px] bg-black/70 rounded px-2 py-1 font-mono pointer-events-none" id="hctpOverlay"></div>
      </div>
      <div class="mt-1.5 flex flex-wrap gap-2 text-[10px]">
        <span id="backendStatus" class="text-gray-500">Backend: —</span>
        <span class="ml-auto text-gray-500" id="autoChartInfo">Auto-selecting best</span>
      </div>
    </div>

    <div class="lg:col-span-3 glass rounded-2xl p-2.5">
      <div class="flex justify-between items-center mb-1.5"><h3 class="text-[11px] font-bold text-fuchsia-300 uppercase tracking-widest">// SIGNAL</h3></div>
      <div id="signalDetail" class="space-y-1.5 text-[11px]">
        <div class="text-gray-500 text-center py-4">Суралцаж байна...</div>
      </div>
      <div class="mt-2 inner rounded-lg p-2">
        <div class="flex justify-between text-[11px] mb-1"><span class="text-gray-400">Confidence</span><b id="compScore" class="text-white text-sm">—</b></div>
        <div class="h-2 bg-black/40 rounded-full overflow-hidden"><div id="compBar" class="h-full bg-gradient-to-r from-purple-500 to-cyan-400" style="width:0%"></div></div>
        <div id="compSignal" class="text-[11px] mt-1.5 text-center font-bold text-gray-400">—</div>
        <div id="filterInfo" class="text-[9px] mt-1.5 text-center text-gray-500 font-mono">—</div>
      </div>
      <!-- Best Config live view -->
      <div class="mt-2 inner rounded-lg p-2 best-glow">
        <div class="flex justify-between items-center mb-1.5">
          <span class="text-[10px] text-yellow-300 font-bold">🏆 ACTIVE BEST CONFIG</span>
          <span id="bestAge" class="text-[8px] text-gray-500 font-mono">—</span>
        </div>
        <div id="activeBestCfg" class="space-y-0.5 text-[9px]">
          <div class="text-gray-500 text-center py-2">Хүлээж байна...</div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-2 mt-2">
    <div class="lg:col-span-4 glass rounded-2xl p-2.5 text-xs">
      <div class="flex justify-between items-center pb-1 border-b border-purple-500/20 mb-2"><h3 class="font-bold text-purple-300 uppercase text-[10px] tracking-widest">POSITIONS</h3><span id="posCount" class="text-[10px] text-gray-400 font-mono">0</span></div>
      <div id="posList" class="space-y-2 max-h-[240px] overflow-auto text-[10px]"><div class="text-gray-500 text-center py-4">Байрлалгүй</div></div>
    </div>
    <div class="lg:col-span-4 glass rounded-2xl p-2.5 text-xs">
      <div class="flex justify-between items-center pb-1 border-b border-purple-500/20 mb-2"><h3 class="font-bold text-cyan-300 uppercase text-[10px] tracking-widest">TRADES</h3><span id="histCount" class="text-[10px] text-gray-400 font-mono">0</span></div>
      <div class="max-h-[240px] overflow-auto">
        <table class="w-full text-right text-[10px]"><thead class="sticky top-0 bg-[#0f0a20]"><tr class="text-purple-400/70 border-b border-purple-500/20"><th class="text-left pl-1">Time</th><th class="text-left">Sym</th><th>V</th><th>R</th><th>Net</th></tr></thead>
        <tbody id="histBody"><tr><td colspan="5" class="text-center py-4 text-gray-500">—</td></tr></tbody></table>
      </div>
    </div>
    <div class="lg:col-span-4 glass rounded-2xl p-2.5 text-xs">
      <div class="flex justify-between items-center pb-1 border-b border-purple-500/20 mb-2"><h3 class="font-bold text-amber-300 uppercase text-[10px] tracking-widest">LOG</h3><button id="clearLogBtn" class="text-[10px] text-gray-400 hover:text-white transition">Clear</button></div>
      <div id="log" class="bg-[#08050f] p-2 rounded border border-purple-500/15 h-[240px] overflow-auto text-[10px] font-mono space-y-1"></div>
    </div>
  </div>
</div>

<!-- BACKTEST TAB -->
<div id="tab-content-backtest" class="hidden">
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-2">
    <div class="glass rounded-2xl p-3">
      <h3 class="text-xs font-bold text-cyan-300 uppercase tracking-widest mb-3">// CONFIG</h3>
      <div class="space-y-2 text-xs">
        <label class="inner rounded-lg p-2 block"><div class="text-gray-400 mb-1 text-[10px]">Symbol</div>
          <select id="btSym" class="w-full bg-transparent text-white font-bold outline-none cursor-pointer"></select></label>
        <label class="inner rounded-lg p-2 block"><div class="text-gray-400 mb-1 text-[10px]">TF</div>
          <select id="btTf" class="w-full bg-transparent text-purple-300 font-bold outline-none cursor-pointer"><option value="1m">1m</option><option value="3m">3m</option><option value="5m" selected>5m</option></select></label>
        <label class="inner rounded-lg p-2 block"><div class="text-gray-400 mb-1 text-[10px]">Bars</div>
          <select id="btBars" class="w-full bg-transparent text-emerald-300 font-bold outline-none cursor-pointer"><option>500</option><option selected>1000</option><option>1500</option></select></label>
        <label class="inner rounded-lg p-2 block"><div class="text-gray-400 mb-1 text-[10px]">Balance</div>
          <input id="btBal" type="number" value="1000" class="w-full bg-transparent text-white font-bold outline-none"></label>
        <label class="inner rounded-lg p-2 block"><div class="text-gray-400 mb-1 text-[10px]">Min Score</div>
          <input id="btMinScore" type="number" value="4" class="w-full bg-transparent text-amber-300 font-bold outline-none"></label>
        <label class="inner rounded-lg p-2 block"><div class="text-gray-400 mb-1 text-[10px]">Risk %</div>
          <input id="btRisk" type="number" value="0.5" step="0.1" class="w-full bg-transparent text-fuchsia-300 font-bold outline-none"></label>
        <label class="inner rounded-lg p-2 flex items-center gap-2"><input type="checkbox" id="btEvo" checked class="accent-cyan-400 cursor-pointer"><span class="text-gray-400 text-[10px]">TUSAM v3 + AutoOpt</span></label>
      </div>
    </div>
    <div class="glass rounded-2xl p-3 lg:col-span-3">
      <h3 class="text-xs font-bold text-purple-300 uppercase tracking-widest mb-3">// RUN</h3>
      <button id="btRunBtn" class="grad w-full py-3 rounded-lg text-sm font-bold mb-2 flex items-center justify-center gap-2">
        <i class="fa-solid fa-flask"></i> RUN BACKTEST
      </button>
      <div id="btStatus" class="text-[11px] text-cyan-300 text-center font-mono">Ready</div>
      <div id="btBestLbl" class="text-[10px] text-yellow-300 text-center mt-2 font-mono"></div>
    </div>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-2 mt-2">
    <div class="glass rounded-2xl p-3 lg:col-span-2">
      <h3 class="text-xs font-bold text-purple-300 uppercase tracking-widest mb-2">// EQUITY</h3>
      <div class="relative bg-[#0a0618] w-full rounded-lg overflow-hidden inner" style="height:250px"><canvas id="btEqCanvas" style="width:100%;height:100%;display:block"></canvas></div>
    </div>
    <div class="glass rounded-2xl p-3">
      <h3 class="text-xs font-bold text-emerald-300 uppercase tracking-widest mb-2">// METRICS</h3>
      <div id="btMetrics" class="space-y-1 text-[11px]"><div class="text-gray-500 text-center py-4">Run дарж ажиллуулна уу</div></div>
    </div>
  </div>
</div>

<!-- ANALYTICS TAB -->
<div id="tab-content-analytics" class="hidden">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-2">
    <div class="glass rounded-2xl p-3"><h3 class="text-xs font-bold text-cyan-300 uppercase tracking-widest mb-2">// RECENT TRADES</h3>
      <div id="attribTable" class="text-[11px]">—</div></div>
    <div class="glass rounded-2xl p-3"><h3 class="text-xs font-bold text-fuchsia-300 uppercase tracking-widest mb-2">// METRICS</h3>
