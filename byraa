// HCTP SIGNAL
// ============================================================
function dltpTrendPredictor(weeklyK){
  const n=weeklyK.length; if(n<30) return {trend:'neutral',confidence:0,output:0};
  const closes=weeklyK.map(k=>k.c);
  const ema10=EMA(closes,10); if(!ema10) return {trend:'neutral',confidence:0,output:0};
  const emaSlope=(ema10[ema10.length-1]-ema10[ema10.length-3])/ema10[ema10.length-3]*100;
  const rsiArr=RSI(closes,14);
  const rsiVal=rsiArr&&rsiArr.length>0?rsiArr[rsiArr.length-1]:50;
  const ema20=EMA(closes,20);
  const pr=closes[closes.length-1];
  const pricePos=ema20?(pr-ema20[ema20.length-1])/ema20[ema20.length-1]*100:0;
  const h1=Math.tanh(emaSlope*10), h2=Math.tanh((rsiVal-50)/20), h3=Math.tanh(pricePos/5);
  const output=0.5*h1+0.3*h2+0.2*h3;
  let trend='neutral',confidence=0;
  if(output>0.15){trend='bullish';confidence=Math.min(100,Math.round(Math.abs(output)*200));}
  else if(output<-0.15){trend='bearish';confidence=Math.min(100,Math.round(Math.abs(output)*200));}
  return {trend,confidence,output};
}
function detectCandlePatterns(k){
  const n=k.length; if(n<5) return [];
  const c1=k[n-3],c2=k[n-2],c3=k[n-1];
  const body=c=>Math.abs(c.c-c.o);
  const range=c=>(c.h-c.l)||1;
  const upWick=c=>c.h-Math.max(c.o,c.c);
  const loWick=c=>Math.min(c.o,c.c)-c.l;
  const isBull=c=>c.c>c.o;
  const isBear=c=>c.c<c.o;
  const patterns=[]; const b3=body(c3),r3=range(c3);
  if(loWick(c3)>b3*2 && b3/r3<0.4) patterns.push({name:'Hammer',dir:1,score:2});
  if(isBear(c2) && upWick(c3)>b3*2 && b3/r3<0.35) patterns.push({name:'InvHammer',dir:1,score:2});
  if(isBull(c2) && upWick(c3)>b3*2 && b3/r3<0.35) patterns.push({name:'ShootingStar',dir:-1,score:2});
  if(isBear(c2)&&isBull(c3)&&c3.o<c2.c&&c3.c>c2.o&&body(c3)>body(c2)) patterns.push({name:'BullEngulf',dir:1,score:3});
  if(isBear(c1)&&body(c2)/range(c2)<0.3&&isBull(c3)&&c3.c>(c1.o+c1.c)/2) patterns.push({name:'MorningStar',dir:1,score:3});
  if(isBear(c2)&&isBull(c3)&&c3.o>c2.c&&c3.c<c2.o&&body(c3)<body(c2)*0.7) patterns.push({name:'BullHarami',dir:1,score:2});
  if(isBull(c2)&&isBear(c3)&&c3.o>c2.c&&c3.c<c2.o&&body(c3)>body(c2)) patterns.push({name:'BearEngulf',dir:-1,score:3});
  if(isBull(c1)&&body(c2)/range(c2)<0.3&&isBear(c3)&&c3.c<(c1.o+c1.c)/2) patterns.push({name:'EveningStar',dir:-1,score:3});
  if(isBull(c2)&&isBear(c3)&&c3.o<c2.c&&c3.c>c2.o&&body(c3)<body(c2)*0.7) patterns.push({name:'BearHarami',dir:-1,score:2});
  return patterns;
}
function hctpSignal(k5, kWeekly, sym){
  const dltp=dltpTrendPredictor(kWeekly);
  const patterns=detectCandlePatterns(k5);
  if(!patterns.length) return {dir:0,score:0,reason:'no pattern',details:null,dltp,sym};
  patterns.sort((a,b)=>b.score-a.score);
  const best=patterns[0];
  const dltpBull=dltp.trend==='bullish';
  const dltpBear=dltp.trend==='bearish';
  const patLong=best.dir===1, patShort=best.dir===-1;
  const alignedLong=patLong&&dltpBull;
  const alignedShort=patShort&&dltpBear;
  if(!alignedLong && !alignedShort) return {dir:0,score:0,reason:'HTF conflict',details:null,dltp,pattern:best,sym};
  if(dltp.confidence < CFG.dltpConfMin) return {dir:0,score:0,reason:'DLTP low',details:null,dltp,pattern:best,sym};
  if(best.score < CFG.patternScoreMin) return {dir:0,score:0,reason:'pattern weak',details:null,dltp,pattern:best,sym};
  let A=ATR(k5,14);
  const entry=k5[k5.length-1].c;
  if(!A || A<=0) A = entry*0.01;
  const slDist=A*1.5, tp1Dist=A*1.5, tp2Dist=A*3.0;
  let sl,tp1,tp2;
  if(best.dir===1){sl=entry-slDist;tp1=entry+tp1Dist;tp2=entry+tp2Dist;}
  else{sl=entry+slDist;tp1=entry-tp1Dist;tp2=entry-tp2Dist;}
  let score=0;
  score+=Math.min(2,best.score);
  if(dltp.confidence>=60) score+=2; else if(dltp.confidence>=40) score+=1;
  if(Math.abs(dltp.output)>0.3) score+=1;
  if(A>0) score+=1;
  return {dir:best.dir, score:Math.min(6,score), reason:'HCTP: '+best.name+' + '+dltp.trend, details:{pattern:best.name,patternScore:best.score,dltpTrend:dltp.trend,dltpConf:dltp.confidence,aligned:true,atr:A}, entry,sl,tp1,tp2,dltp,pattern:best,sym};
}

