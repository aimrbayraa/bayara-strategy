async function runBT(){
  const sym=$('btSym').value||'BTCUSDT';
  const tf=$('btTf').value||'5m';
  const bars=parseInt($('btBars').value)||1000;
  const startBal=parseFloat($('btBal').value)||1000;
  const minScore=parseInt($('btMinScore').value)||4;
  const riskPct=parseFloat($('btRisk').value)||0.5;
  const useEvo = $('btEvo')?$('btEvo').checked:true;
  if($('btStatus'))$('btStatus').textContent='⏳ Уншиж байна...';
  if($('btBestLbl'))$('btBestLbl').textContent='';
  try{
    const k5=await fetchK(sym,tf,bars);
    const k4=await fetchK(sym,CFG.htf,200);
    const kw=await fetchK(sym,'1w',60);
    if(!k5.length){if($('btStatus'))$('btStatus').textContent='❌ Data хоосон';return;}
    const btEvo = useEvo ? new TUSAMv3(startBal) : null;
    const btBest = useEvo ? new BestConfigManager() : null;
    let bal=startBal, peak=startBal, maxDD=0;
    const trades=[],eqC=[startBal];
    let pos=null;
    for(let i=50;i<k5.length-1;i++){
      const slice=k5.slice(0,i+1);
      updateCtx(k4,k5[i].c);
      const regime = detectRegime(slice,k4);
      const candle=k5[i];
      if(pos && btEvo && btEvo.open) btEvo.tick(sym, candle.c);
      if(pos){
        let closed=false, exitPx=candle.c, reason='';
        if(pos.side==='LONG'){
          if(candle.l<=pos.sl){closed=true;exitPx=pos.sl;reason='SL';}
          else if(candle.h>=pos.tp2){closed=true;exitPx=pos.tp2;reason='TP2';}
        } else {
          if(candle.h>=pos.sl){closed=true;exitPx=pos.sl;reason='SL';}
          else if(candle.l<=pos.tp2){closed=true;exitPx=pos.tp2;reason='TP2';}
        }
        if(closed){
          const pnlPU=pos.side==='LONG'?(exitPx-pos.entry):(pos.entry-exitPx);
          const net=(pnlPU*pos.size)-(pos.size*exitPx*CFG.feeRate);
          bal+=net; peak=Math.max(peak,bal);
          maxDD=Math.max(maxDD,((peak-bal)/peak)*100);
          trades.push({side:pos.side,entry:pos.entry,exit:exitPx,R:pnlPU/pos.slD,net,reason,v:pos.v||'—',regime:pos.regime||'—'});
          eqC.push(bal);
          if(btEvo){
            const evoCtx = {sym, dir:pos.side==='LONG'?1:-1, entry:pos.entry, conf:0.5, version:pos.v, regime:pos.regime, feat:new Array(14).fill(0), mfe:0, mae:0, tp1:pos.tp1, tp2:pos.tp2, sl:pos.sl};
            btEvo.onClose(exitPx, evoCtx);
          }
          if(btBest && btBest.shouldEval(trades.length)){
            const r = btBest.evaluate(btEvo, {n:trades.length}, regime);
            if(r && r.newBest && CFG.autoApplyBest) btBest.applyBest(btEvo);
          }
          pos=null;
        }
      }
      if(!pos&&bal>50){
        const sig=hctpSignal(slice,kw,sym);
        sig.sym=sym;
        if(sig.dir!==0 && sig.score>=minScore){
          let finalSig = sig;
          if(btEvo){
            const evoOut = btEvo.predict(sig, slice, sig.dltp, regime);
            if(evoOut) finalSig={dir:evoOut.dir,score:evoOut.score,entry:evoOut.entry,sl:evoOut.sl,tp1:evoOut.tp1,tp2:evoOut.tp2,version:evoOut.version,regime};
            else finalSig=null;
          }
          if(finalSig){
            const slD=Math.abs(finalSig.entry-finalSig.sl);
            if(slD>0) pos={side:finalSig.dir>0?'LONG':'SHORT',entry:finalSig.entry,size:(bal*(riskPct/100))/slD,sl:finalSig.sl,tp1:finalSig.tp1,tp2:finalSig.tp2,slD,v:finalSig.version||'—',regime:finalSig.regime||'—'};
          }
        }
      }
    }
    const total=trades.length;
    const wr=total>0?(trades.filter(t=>t.net>0).length/total)*100:0;
    const netPnl=bal-startBal;
    const avgR=total>0?trades.reduce((a,t)=>a+t.R,0)/total:0;
    const profitFactor=(()=>{const w=trades.filter(t=>t.net>0).reduce((a,t)=>a+t.net,0);const l=Math.abs(trades.filter(t=>t.net<0).reduce((a,t)=>a+t.net,0));return l>0?w/l:(w>0?999:0);})();
    const sharpe=(()=>{if(!eqC.length||eqC.length<3)return 0;const rets=[];for(let i=1;i<eqC.length;i++)rets.push((eqC[i]-eqC[i-1])/eqC[i-1]);const mean=rets.reduce((a,b)=>a+b,0)/rets.length;const std=Math.sqrt(rets.reduce((a,b)=>a+(b-mean)**2,0)/rets.length);return std>0?(mean/std)*Math.sqrt(252):0;})();
    if($('btMetrics'))$('btMetrics').innerHTML=
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Net PnL</span><b class="'+(netPnl>=0?'val-pos':'val-neg')+'">'+(netPnl>=0?'+':'')+'$'+fN(netPnl)+'</b></div>'+
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Trades</span><b>'+total+'</b></div>'+
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Win Rate</span><b class="'+(wr>=50?'val-pos':'val-neg')+'">'+wr.toFixed(1)+'%</b></div>'+
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Avg R</span><b class="'+(avgR>=0?'val-pos':'val-neg')+'">'+(avgR>=0?'+':'')+avgR.toFixed(2)+'</b></div>'+
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Profit Factor</span><b class="text-cyan-300">'+profitFactor.toFixed(2)+'</b></div>'+
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Sharpe (ann.)</span><b class="text-fuchsia-300">'+sharpe.toFixed(2)+'</b></div>'+
      '<div class="flex justify-between border-b border-purple-500/10 py-1"><span class="text-gray-400">Max DD</span><b class="text-amber-300">'+maxDD.toFixed(1)+'%</b></div>'+
      (btBest&&btBest.best?'<div class="flex justify-between border-b border-yellow-500/20 py-1 bg-yellow-500/5"><span class="text-yellow-300">🏆 Best Score</span><b class="text-yellow-300">'+btBest.best.score.toFixed(3)+'</b></div>':'');
    drawChart('btEqCanvas',eqC,netPnl>=0);
    if($('btStatus'))$('btStatus').textContent='✅ '+total+' trades | $'+fN(netPnl)+' | WR '+wr.toFixed(0)+'%';
    if($('btBestLbl') && btBest && btBest.best){
      $('btBestLbl').textContent='🏆 Best: '+btBest.best.version.toUpperCase()+' | Score '+btBest.best.score.toFixed(3)+
        ' | WR '+(btBest.best.wr*100).toFixed(0)+'% | Improvements '+btBest.improveCount;
    }
    log('📊 BT '+sym+' — '+total+' trades WR '+wr.toFixed(0)+'% PF '+profitFactor.toFixed(2),netPnl>=0?'text-emerald-300':'text-rose-400');
  }catch(e){console.warn('bt',e);if($('btStatus'))$('btStatus').textContent='❌ Error';}
}

function drawChart(id,data,isPos){
  const c=$(id); if(!c||!data||data.length<2) return;
  const dpr=window.devicePixelRatio||1;
  const W=c.parentElement.clientWidth||600,H=c.parentElement.clientHeight||220;
  if(W<=0 || H<=0) return;
  c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';
  const x=c.getContext('2d');
  x.setTransform(1,0,0,1,0,0);x.scale(dpr,dpr);x.clearRect(0,0,W,H);
  const min=Math.min(...data),max=Math.max(...data);
  const pad=(max-min)*0.1||10;
  const mn=min-pad,mx=max+pad;
  x.strokeStyle=isPos?'#0ecb81':'#f6465d';x.lineWidth=2;
  x.beginPath();
  for(let i=0;i<data.length;i++){
    const px=(W/(data.length-1))*i;
    const py=H-((data[i]-mn)/(mx-mn))*H;
    if(i===0)x.moveTo(px,py);else x.lineTo(px,py);
  }
  x.stroke();
  x.lineTo(W,H);x.lineTo(0,H);x.closePath();
  x.fillStyle=isPos?'rgba(14,203,129,0.1)':'rgba(246,70,93,0.1)';x.fill();
}

