function switchTab(t){
  ['live','backtest','analytics','evolution','brain','optimizer','checklist'].forEach(id=>{
    const b=$('tab-'+id), c=$('tab-content-'+id);
    if(!b||!c) return;
    if(id===t){b.classList.add('active');c.classList.remove('hidden');}
    else{b.classList.remove('active');c.classList.add('hidden');}
  });
  if(t==='analytics') setTimeout(renderAnalytics,50);
  if(t==='evolution') setTimeout(renderEvoStatus,50);
  if(t==='brain') setTimeout(renderBrain,50);
  if(t==='optimizer') setTimeout(renderBestCfgTab,50);
  if(t==='live'&&ACTIVE) setTimeout(()=>loadTV(ACTIVE,CFG.tf),100);
}

function updateCfg(){
  CFG.tf=$('tfSel').value; CFG.htf=$('htfSel').value;
  CFG.minScore=parseInt($('scoreSel').value);
  CFG.riskPct=parseFloat($('riskSel').value);
  applySpeed($('speedSel').value);
  if(ACTIVE){selectSym(ACTIVE);loadTV(ACTIVE,CFG.tf);}
}

