function managePos(){
  if(!S.positions.length) return;
  S.positions.slice().forEach(pos=>{
    const px=(pos.sym===ACTIVE&&price>0)?price:pos.entry;
    if(pos.sym===ACTIVE && price>0){
      if(pos.side==='LONG'){pos.mfe=Math.max(pos.mfe||0,price-pos.entry);pos.mae=Math.min(pos.mae||0,price-pos.entry);}
      else{pos.mfe=Math.max(pos.mfe||0,pos.entry-price);pos.mae=Math.min(pos.mae||0,pos.entry-price);}
      evo.tick(pos.sym, price);
    }
    if(!pos.partial&&((pos.side==='LONG'&&px>=pos.tp1)||(pos.side==='SHORT'&&px<=pos.tp1))){
      closePos(pos,pos.tp1,'TP1',pos.size/2);
      if(S.positions.includes(pos)){pos.partial=true;pos.be=true;pos.sl=pos.entry;}
      return;
    }
    if(pos.side==='LONG'){
      if(px<=pos.sl) closePos(pos,pos.sl,pos.be?'BE':'SL');
      else if(px>=pos.tp2) closePos(pos,pos.tp2,'TP2');
    } else {
      if(px>=pos.sl) closePos(pos,pos.sl,pos.be?'BE':'SL');
      else if(px<=pos.tp2) closePos(pos,pos.tp2,'TP2');
    }
  });
}

