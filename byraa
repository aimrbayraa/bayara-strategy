function bind(){
  ['live','backtest','analytics','evolution','brain','optimizer','checklist'].forEach(t=>{const b=$('tab-'+t);if(b)b.addEventListener('click',()=>switchTab(t));});
  if($('botBtn'))$('botBtn').addEventListener('click',toggleBot);
  if($('liveBtn'))$('liveBtn').addEventListener('click',()=>{
    CFG.liveMode=!CFG.liveMode;
    if($('liveModeTxt'))$('liveModeTxt').textContent=CFG.liveMode?'LIVE':'PAPER';
    log(CFG.liveMode?'⚠️ LIVE':'📝 PAPER',CFG.liveMode?'text-rose-400':'text-emerald-300');
  });
  if($('resetBtn'))$('resetBtn').addEventListener('click',()=>promptConfirm('<i class="fa-solid fa-triangle-exclamation text-rose-400"></i> Reset','Бүх зүйлийг $1,000-д буцаах уу?','Тийм',forceReset));
  if($('clearLogBtn'))$('clearLogBtn').addEventListener('click',()=>{if($('log'))$('log').innerHTML='';});
  if($('modalCancelBtn'))$('modalCancelBtn').addEventListener('click',()=>closeModal(false));
  if($('modalConfirmBtn'))$('modalConfirmBtn').addEventListener('click',()=>closeModal(true));
  if($('btRunBtn'))$('btRunBtn').addEventListener('click',runBT);
  if($('evoExportBtn'))$('evoExportBtn').addEventListener('click',()=>{
    const data=JSON.stringify(evo.serialize(),null,2);
    const blob=new Blob([data],{type:'application/json'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;a.download='tusam-v3-'+Date.now()+'.json';
    a.click();URL.revokeObjectURL(url);
  });
  if($('brainRetrainBtn'))$('brainRetrainBtn').addEventListener('click',()=>{
    if(evo.buffer.buf.length<20){log('⚠️ Buffer too small','text-amber-300');return;}
    log('🔄 Force retrain...','text-fuchsia-300');
    for(let epoch=0;epoch<100;epoch++){
      const batch=evo.buffer.sample(CFG.batchSize);
      batch.forEach(exp=>{const w=1+Math.min(1,Math.abs(exp.reward)/3);evo.ensemble.train(exp.feat,exp.label,w);});
    }
    evo.trainBatches+=100;
    S.evo=evo.serialize();scheduleSave();
    log('✅ Retrain complete','text-emerald-300');
    renderBrain();
  });
  if($('forceEvalBtn')) $('forceEvalBtn').addEventListener('click',()=>{
    if(S.n < bestCfg.minTrades){
      log('⚠️ Need '+bestCfg.minTrades+' trades, currently '+S.n,'text-amber-300');
      return;
    }
    const r = bestCfg.evaluate(evo, S, currentRegime);
    if(r){
      if(r.newBest){
        log('🏆 FORCE EVAL → NEW BEST! Score:'+r.snapshot.score.toFixed(3),'text-yellow-300');
        if(CFG.autoApplyBest && bestCfg.autoApply) bestCfg.applyBest(evo);
      } else {
        log('📊 FORCE EVAL → Score:'+r.snapshot.score.toFixed(3)+' (best:'+bestCfg.best.score.toFixed(3)+')','text-cyan-300');
      }
      S.evo=evo.serialize();S.bestCfg=bestCfg.serialize();scheduleSave();
      renderBestCfgBar();renderBestCfgTab();
    }
  });
  if($('optApplyBtn')) $('optApplyBtn').addEventListener('click',()=>{
    if(!bestCfg.best){log('⚠️ No best config yet','text-amber-300');return;}
    bestCfg.applyBest(evo);
    S.evo=evo.serialize();scheduleSave();
    log('✅ Best config MANUALLY applied → confThr:'+evo.confThr.toFixed(3)+' MFE×:'+evo.mfeMulti.toFixed(2)+' SL×:'+evo.slMulti.toFixed(2),'text-yellow-300');
    renderEvoStatus();
  });
  if($('optExportBtn')) $('optExportBtn').addEventListener('click',()=>{
    if(!bestCfg.best){log('⚠️ No best config','text-amber-300');return;}
    const data=JSON.stringify(bestCfg.serialize(),null,2);
    const blob=new Blob([data],{type:'application/json'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;a.download='best-config-'+Date.now()+'.json';
    a.click();URL.revokeObjectURL(url);
  });
  ['tfSel','htfSel','scoreSel','riskSel','speedSel'].forEach(id=>{const el=$(id);if(el)el.addEventListener('change',updateCfg);});
}

