function updateCtx(k4,p){
  const n=k4.length; if(n<20) return;
  const closes=k4.map(x=>x.c);
  const e50=EMA(closes,Math.min(50,Math.floor(closes.length/2)));
  if(!e50) return;
  const e50Now=e50[e50.length-1], e50Prev=e50[Math.max(0,e50.length-15)];
  let bias='neutral';
  const slope=(e50Now-e50Prev)/e50Prev*100;
  if(Math.abs(slope)<0.25 && p>e50Now*0.985 && p<e50Now*1.015) bias='range';
  else if(p>e50Now) bias='long';
  else if(p<e50Now) bias='short';
  const lb=k4.slice(-Math.min(CFG.rangeLook,k4.length));
  const rH=Math.max(...lb.map(x=>x.h));
  const rL=Math.min(...lb.map(x=>x.l));
  const rM=(rH+rL)/2;
  const size=rH-rL;
  let zone='mid';
  if(size>0){const pos=(p-rL)/size;if(pos>=0.75)zone='top';else if(pos<=0.25)zone='bottom';}
  marketCtx.bias=bias;marketCtx.rangeH=rH;marketCtx.rangeL=rL;
  marketCtx.rangeM=rM;marketCtx.zone=zone;marketCtx.ema50=e50Now;
  const bc={long:'text-emerald-300',short:'text-rose-400',range:'text-purple-300',neutral:'text-gray-400'};
  if($('biasVal')){$('biasVal').textContent=bias.toUpperCase();$('biasVal').className=bc[bias]||'text-gray-400';}
}

