async function scanOne(coin){
  if(!coin) return;
  const st=scanStats[coin.sym]||{};
  st.status='SCANNING'; scanStats[coin.sym]=st;
  try{
    const [k4,k5,kw]=await Promise.all([getHTF(coin.sym),fetchK(coin.sym,CFG.tf,CFG.k5Limit),getWeekly(coin.sym)]);
    if(!k4?.length||!k5?.length||!kw?.length){st.status='NO DATA';return;}
    const lastP=k5[k5.length-1].c;
    updateCtx(k4,lastP);
    const regime = detectRegime(k5, k4);
    const sig=hctpSignal(k5,kw,coin.sym);
    sig.sym=coin.sym;
    st.bias=marketCtx.bias; st.zone=marketCtx.zone;
    st.dltp=sig.dltp?sig.dltp.trend:'—';
    st.pattern=sig.pattern?sig.pattern.name:'—';
    st.regime = regime;
    let finalSig = sig;
    let evoOut = null;
    if(CFG.useTusam && sig.dir !== 0){
      evoOut = evo.predict(sig, k5, sig.dltp, regime);
      if(evoOut){
        finalSig = {
          dir:evoOut.dir, score:evoOut.score, reason:'TUSAM['+evoOut.version+'] '+sig.reason, details:sig.details,
          entry:evoOut.entry, sl:evoOut.sl, tp1:evoOut.tp1, tp2:evoOut.tp2,
          dltp:sig.dltp, pattern:sig.pattern, evoVersion:evoOut.version, evoConf:evoOut.conf,
          regime:regime, uncertainty:evoOut.uncertainty, agreement:evoOut.agreement, feat:evoOut.feat, sym:coin.sym
        };
      } else {
        finalSig = {dir:0, score:sig.score, reason:'AI reject', details:sig.details, dltp:sig.dltp, pattern:sig.pattern, sym:coin.sym};
      }
    }
    st.score=finalSig.score; st.dir=finalSig.dir; st.price=lastP; st.sig=finalSig;
    st.evoV=evoOut?evoOut.version:'—'; st.ts=Date.now();
    if(finalSig.dir!==0 && finalSig.score>=CFG.minScore){
      st.status=finalSig.dir>0?'LONG':'SHORT';
      const i=scanResults.findIndex(r=>r.sym===coin.sym);
      const e={sym:coin.sym,score:finalSig.score,dir:finalSig.dir,price:lastP,sig:finalSig,candles:k5,regime};
      if(i>=0) scanResults[i]=e; else scanResults.push(e);
    } else {
      st.status=finalSig.reason&&finalSig.reason.indexOf('reject')>=0?'FILTERED':'WAIT';
      scanResults=scanResults.filter(r=>r.sym!==coin.sym);
    }
    totalScan++;
    if($('totScanned'))$('totScanned').textContent=totalScan;
    scanResults.sort((a,b)=>b.score-a.score);
    if($('sigCount'))$('sigCount').textContent=scanResults.length;
    if(totalScan % 20 === 0){S.evo = evo.serialize(); S.bestCfg = bestCfg.serialize(); scheduleSave();}
  }catch(e){st.status='ERR';}
}

async function scanBatch(){
  if(scanning||!scanQueue.length) return;
  scanning=true; lastStart=Date.now();
  if($('scanStatus'))$('scanStatus').textContent='scanning...';
