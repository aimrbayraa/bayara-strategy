// BEST CONFIG MANAGER
// ============================================================
class BestConfigManager {
  constructor(){
    this.best = null;
    this.history = [];
    this.lastEvalTrade = 0;
    this.evalCount = 0;
    this.improveCount = 0;
    this.lastScore = null;
    this.autoApply = CFG.autoApplyBest;
    this.evalInterval = CFG.evalInterval;
    this.minTrades = CFG.minEvalTrades;
  }
  progress(totalTrades){
    const sinceLast = totalTrades - this.lastEvalTrade;
    if(totalTrades < this.minTrades) return {current: totalTrades, target: this.minTrades, phase: 'warmup', pct: Math.min(100, (totalTrades/this.minTrades)*100)};
    const inCycle = sinceLast % this.evalInterval;
    return {current: inCycle, target: this.evalInterval, phase: 'ready', pct: (inCycle/this.evalInterval)*100};
  }
  shouldEval(totalTrades){
    if(totalTrades < this.minTrades) return false;
    return (totalTrades - this.lastEvalTrade) >= this.evalInterval;
  }
  evaluate(evo, S, currentRegime){
    const recent = evo.journal.slice(-CFG.rollingWindow);
    if(recent.length < this.minTrades) return null;
    const wins = recent.filter(j=>j.label === 1).length;
    const wr = wins/recent.length;
    const avgR = recent.reduce((a,j)=>a+(j.R||0),0)/recent.length;
    const eq = evo.equity.slice(-(CFG.rollingWindow+1));
    let sharpe = 0;
    if(eq.length > 2){
      const rets = [];
      for(let i=1;i<eq.length;i++) rets.push((eq[i]-eq[i-1])/eq[i-1]);
      const mean = rets.reduce((a,b)=>a+b,0)/rets.length;
      const std = Math.sqrt(rets.reduce((a,b)=>a+(b-mean)**2,0)/rets.length);
      sharpe = std > 0 ? mean/std : 0;
    }
    const score = (wr * 2.0) + (Math.max(0, avgR) * 0.5) + (Math.max(0, sharpe) * 0.3);
    const snapshot = {
      confThr: +evo.confThr.toFixed(4),
      mfeMulti: +evo.mfeMulti.toFixed(3),
      slMulti: +evo.slMulti.toFixed(3),
      version: evo.useVersion,
      regime: currentRegime,
      score: +score.toFixed(4),
      wr: +wr.toFixed(4),
      avgR: +avgR.toFixed(3),
      sharpe: +sharpe.toFixed(3),
      capital: +evo.capital.toFixed(2),
      trades: recent.length,
      ts: Date.now()
    };
    this.lastEvalTrade = S.n;
    this.evalCount++;
    this.lastScore = snapshot.score;

    let isNewBest = false;
    if(!this.best || score > this.best.score){
      this.best = {...snapshot};
      this.improveCount++;
      isNewBest = true;
    }
    this.history.push({...snapshot, newBest: isNewBest});
    if(this.history.length > 200) this.history.shift();

    return {newBest: isNewBest, snapshot};
  }
  applyBest(evo){
    if(!this.best) return false;
    evo.confThr = this.best.confThr;
    evo.mfeMulti = this.best.mfeMulti;
    evo.slMulti = this.best.slMulti;
    if(this.best.version && evo.elo.elo[this.best.version] !== undefined){
      evo.elo.elo[this.best.version] = Math.max(evo.elo.elo[this.best.version], 1550);
    }
    return true;
  }
  serialize(){
    return {
      best: this.best,
      history: this.history.slice(-100),
      lastEvalTrade: this.lastEvalTrade,
      evalCount: this.evalCount,
      improveCount: this.improveCount,
      lastScore: this.lastScore,
      autoApply: this.autoApply,
    };
  }
  loadState(d){
    if(!d) return;
    this.best = d.best;
    this.history = d.history || [];
    this.lastEvalTrade = d.lastEvalTrade || 0;
    this.evalCount = d.evalCount || 0;
    this.improveCount = d.improveCount || 0;
    this.lastScore = d.lastScore || null;
    if(d.autoApply !== undefined) this.autoApply = d.autoApply;
  }
}

