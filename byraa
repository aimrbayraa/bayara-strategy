<script>
(function(){
'use strict';
const $ = id => document.getElementById(id);
const STORAGE_KEY = 'NEXUS_TUSAM_V3_STATE';
const BINANCE = 'https://fapi.binance.com';
const TF_MAP = {'1m':'1m','3m':'3m','5m':'5m','15m':'15m','1h':'1h','4h':'4h','1w':'1w'};
const TV_INT = {'1m':'1','3m':'3','5m':'5','15m':'15','1h':'60','4h':'240'};

const SPEED = {
  slow:   { ms: 3000, batch: 5,  k5: 60, htf: 50, wk: 60, cache: 120000, univ: 20 },
  normal: { ms: 1500, batch: 10, k5: 55, htf: 50, wk: 60, cache: 90000,  univ: 30 },
  fast:   { ms: 800,  batch: 15, k5: 50, htf: 45, wk: 60, cache: 60000,  univ: 40 },
  turbo:  { ms: 400,  batch: 25, k5: 45, htf: 40, wk: 50, cache: 45000,  univ: 50 }
};

const CFG = {
  tf:'5m', htf:'4h', minScore:4, riskPct:0.5, maxPos:2,
  slBuffer:0.2, feeRate:0.0005, maxDD:20, rangeLook:30,
  intervalMs:800, batch:15, k5Limit:50, htfLimit:45, wkLimit:60, htfCache:60000,
  univLimit:40, minVol:5e6, liveMode:false,
  dltpConfMin: 30, patternScoreMin: 2,
  useTusam: true,
  bufferSize: 500, batchSize: 32,
  uncertaintyThr: 0.18, minAgreement: 0.6, eloK: 24,
  autoApplyBest: true,
  evalInterval: 10, minEvalTrades: 20, rollingWindow: 30,
};

function applySpeed(n){
  const p=SPEED[n]||SPEED.fast;
  CFG.intervalMs=p.ms; CFG.batch=p.batch;
  CFG.k5Limit=p.k5; CFG.htfLimit=p.htf; CFG.wkLimit=p.wk;
  CFG.htfCache=p.cache; CFG.univLimit=p.univ;
  if(scanTimer) clearInterval(scanTimer);
  scanTimer=setInterval(scanBatch,CFG.intervalMs);
}

// ============== UTILS ==============
function dec(p){if(!p||p<=0)return 2;if(p>=1000)return 2;if(p>=100)return 3;if(p>=1)return 4;if(p>=0.01)return 5;if(p>=0.001)return 6;return 7;}
function fP(p){if(!p&&p!==0)return '—';return Number(p).toFixed(dec(p));}
function fN(n,d=2){if(!isFinite(n))return '0.00';return Number(n).toLocaleString('en-US',{minimumFractionDigits:d,maximumFractionDigits:d});}
function EMA(a,n){if(a.length<n)return null;const k=2/(n+1);const o=[a.slice(0,n).reduce((x,y)=>x+y,0)/n];for(let i=n;i<a.length;i++)o.push(a[i]*k+o[o.length-1]*(1-k));return o;}
function SMA(a,n){if(a.length<n)return null;const o=[];for(let i=n-1;i<a.length;i++){let s=0;for(let j=i-n+1;j<=i;j++)s+=a[j];o.push(s/n);}return o;}
function StdDev(a,n){if(a.length<n)return null;const o=[];for(let i=n-1;i<a.length;i++){const mean=a.slice(i-n+1,i+1).reduce((x,y)=>x+y,0)/n;let s=0;for(let j=i-n+1;j<=i;j++)s+=(a[j]-mean)**2;o.push(Math.sqrt(s/n));}return o;}
function RSI(a,n){if(a.length<n+1)return null;let g=0,l=0;for(let i=1;i<=n;i++){const d=a[i]-a[i-1];if(d>=0)g+=d;else l-=d;}let ag=g/n,al=l/n;const o=[];for(let i=n+1;i<a.length;i++){const d=a[i]-a[i-1];ag=(ag*(n-1)+(d>0?d:0))/n;al=(al*(n-1)+(d<0?-d:0))/n;o.push(al===0?100:100-100/(1+ag/al));}return o;}
function ATR(k,n){if(k.length<n+1)return 0;let s=0;for(let i=k.length-n;i<k.length;i++){const h=k[i].h,l=k[i].l,pc=k[i-1].c;s+=Math.max(h-l,Math.abs(h-pc),Math.abs(l-pc));}return s/n;}

// ============== REGIME ==============
function detectRegime(k5, k4){
  if(!k5 || k5.length < 30) return 'QUIET';
  const n = k5.length;
  const closes = k5.map(k=>k.c);
  const ema20 = EMA(closes, 20);
  const ema50 = EMA(closes, 50);
  if(!ema20 || !ema50) return 'QUIET';
  const A = ATR(k5, 14);
  const price = closes[n-1];
  if(!price || price<=0) return 'QUIET';
  const atrPct = (A/price)*100;
  const emaSep = Math.abs(ema20[ema20.length-1] - ema50[ema50.length-1]) / price * 100;
  const slope20 = (ema20[ema20.length-1] - ema20[Math.max(0,ema20.length-5)]) / ema20[Math.max(0,ema20.length-5)] * 100;
  if(atrPct > 2.5) return 'VOLATILE';
  if(atrPct < 0.3) return 'QUIET';
  if(emaSep > 0.5 && slope20 > 0.3) return 'TREND_UP';
  if(emaSep > 0.5 && slope20 < -0.3) return 'TREND_DOWN';
  return 'RANGE';
}
function regimeColor(r){
  const map = {'TREND_UP':'text-emerald-300','TREND_DOWN':'text-rose-400','RANGE':'text-purple-300','VOLATILE':'text-amber-300','QUIET':'text-gray-400'};
  return map[r]||'text-gray-400';
}

// ============== TINY MLP ==============
class TinyMLP {
  constructor(inDim, hiddenDim, lr=0.02){
    this.inDim = inDim; this.hidDim = hiddenDim; this.lr = lr;
    this.W1 = this._init(inDim, hiddenDim);
    this.b1 = new Array(hiddenDim).fill(0);
    this.W2 = this._init(hiddenDim, 1);
    this.b2 = [0];
    this._lastLoss = null;
  }
  _init(rows, cols){
    const scale = Math.sqrt(2/rows); const m = [];
    for(let i=0;i<rows;i++){const r=[];for(let j=0;j<cols;j++)r.push((Math.random()*2-1)*scale);m.push(r);}
    return m;
  }
  _sig(x){return 1/(1+Math.exp(-Math.max(-20,Math.min(20,x))));}
  _tanh(x){return Math.tanh(Math.max(-5,Math.min(5,x)));}
  predict(x){
    const h=[];
    for(let i=0;i<this.hidDim;i++){let sum=this.b1[i];for(let j=0;j<this.inDim;j++)sum+=this.W1[j][i]*x[j];h.push(this._tanh(sum));}
    let out=this.b2[0];for(let i=0;i<this.hidDim;i++)out+=this.W2[i][0]*h[i];
    return {p:this._sig(out), h};
  }
  train(x, y, weight=1){
    const {p, h} = this.predict(x);
    const dOut = (p - y) * weight;
    this._lastLoss = Math.abs(p - y);
    const gW2=[];for(let i=0;i<this.hidDim;i++)gW2.push(dOut*h[i]);
    const dH=[];for(let i=0;i<this.hidDim;i++)dH.push(dOut*this.W2[i][0]*(1-h[i]*h[i]));
    const gW1=[];for(let j=0;j<this.inDim;j++){const r=[];for(let i=0;i<this.hidDim;i++)r.push(dH[i]*x[j]);gW1.push(r);}
    for(let i=0;i<this.hidDim;i++)this.W2[i][0]-=this.lr*gW2[i];
    this.b2[0]-=this.lr*dOut;
    for(let j=0;j<this.inDim;j++)for(let i=0;i<this.hidDim;i++)this.W1[j][i]-=this.lr*gW1[j][i];
    for(let j=0;j<this.inDim;j++)for(let i=0;i<this.hidDim;i++)this.W1[j][i]*=0.9995;
    for(let i=0;i<this.hidDim;i++)this.W2[i][0]*=0.9995;
  }
  serialize(){return {W1:this.W1,b1:this.b1,W2:this.W2,b2:this.b2,lr:this.lr,inDim:this.inDim,hidDim:this.hidDim};}
  loadState(d){if(!d)return;this.W1=d.W1||this.W1;this.b1=d.b1||this.b1;this.W2=d.W2||this.W2;this.b2=d.b2||this.b2;if(d.lr)this.lr=d.lr;}
}

class EnsembleMLP {
  constructor(inDim=14, hidDim=8){
    this.models = [new TinyMLP(inDim,hidDim,0.02), new TinyMLP(inDim,hidDim,0.05), new TinyMLP(inDim,hidDim,0.10)];
    this.inDim = inDim;
  }
  predict(x){
    const preds = this.models.map(m=>m.predict(x).p);
    const mean = preds.reduce((a,b)=>a+b,0)/preds.length;
    const variance = preds.reduce((a,b)=>a+(b-mean)**2,0)/preds.length;
    const uncertainty = Math.sqrt(variance);
    const agreement = 1 - Math.min(1, uncertainty*2);
    return {mean, uncertainty, agreement, preds};
  }
  train(x, y, weight=1){
    const losses = this.models.map(m=>{m.train(x,y,weight);return m._lastLoss||0;});
    return losses.reduce((a,b)=>a+b,0)/losses.length;
  }
  serialize(){return this.models.map(m=>m.serialize());}
  loadState(d){if(!Array.isArray(d))return;d.forEach((s,i)=>{if(this.models[i])this.models[i].loadState(s);});}
}

class ReplayBuffer {
  constructor(cap=500){this.cap=cap;this.buf=[];}
  add(exp){this.buf.push(exp);if(this.buf.length>this.cap)this.buf.shift();}
  sample(n){
    if(this.buf.length<=n)return this.buf.slice();
    const out=[];const used=new Set();
    while(out.length<n){const i=Math.floor(Math.random()*this.buf.length);if(!used.has(i)){out.push(this.buf[i]);used.add(i);}}
    return out;
  }
  stats(){
    if(!this.buf.length)return {n:0,avgReward:0,wr:0};
    const rewards=this.buf.map(e=>e.reward||0);
    const wins=this.buf.filter(e=>e.label===1).length;
    return {n:this.buf.length,avgReward:rewards.reduce((a,b)=>a+b,0)/rewards.length,wr:wins/this.buf.length};
  }
  serialize(){return this.buf.slice(-200);}
  loadState(d){if(Array.isArray(d))this.buf=d.slice();}
}

class ELORanker {
  constructor(init=1500){
    this.elo = {ai:init, momentum:init, pattern:init};
    this.K = CFG.eloK;
    this.matches = {ai:0, momentum:0, pattern:0};
  }
  update(version, win){
    const expected = 1/(1+Math.pow(10,(1500-this.elo[version])/400));
    const actual = win?1:0;
    this.elo[version] += this.K*(actual-expected);
    this.elo[version] = Math.max(800,Math.min(2200,this.elo[version]));
    this.matches[version]++;
  }
  best(){return Object.keys(this.elo).sort((a,b)=>this.elo[b]-this.elo[a])[0];}
  serialize(){return {elo:this.elo,matches:this.matches};}
  loadState(d){if(d&&d.elo){this.elo=d.elo;this.matches=d.matches||this.matches;}}
}

// ============== FEATURIZE ==============
function featurize(sig, k5, regime){
  const f = new Array(14).fill(0);
  if(!k5 || k5.length < 30) return f;
  const closes = k5.map(k=>k.c);
  const vols = k5.map(k=>k.v || 0);
  const n = k5.length;
  const price = closes[n-1];
  const rsi7 = RSI(closes,7), rsi14 = RSI(closes,14), rsi21 = RSI(closes,21);
  f[0] = rsi7 && rsi7.length ? (rsi7[rsi7.length-1]-50)/50 : 0;
  f[1] = rsi14 && rsi14.length ? (rsi14[rsi14.length-1]-50)/50 : 0;
  f[2] = rsi21 && rsi21.length ? (rsi21[rsi21.length-1]-50)/50 : 0;
  const ema10 = EMA(closes,10), ema20 = EMA(closes,20);
  if(ema10){const s10=(ema10[ema10.length-1]-ema10[Math.max(0,ema10.length-4)])/ema10[Math.max(0,ema10.length-4)];f[3]=Math.max(-1,Math.min(1,s10*100));}
  if(ema20){const s20=(ema20[ema20.length-1]-ema20[Math.max(0,ema20.length-6)])/ema20[Math.max(0,ema20.length-6)];f[4]=Math.max(-1,Math.min(1,s20*50));}
  const sma20 = SMA(closes,20), std20 = StdDev(closes,20);
  if(sma20 && std20 && std20.length){
    const upper = sma20[sma20.length-1]+2*std20[std20.length-1];
    const lower = sma20[sma20.length-1]-2*std20[std20.length-1];
    const range = upper-lower||1;
    f[5] = ((price-lower)/range - 0.5)*2;
  }
  const A = ATR(k5,14); const atrPct=price>0?(A/price)*100:0;
  f[6] = Math.max(-1,Math.min(1,(atrPct-0.8)/2));
  const avgVol = vols.slice(-20).reduce((a,b)=>a+b,0)/20;
  const recentVol = vols.slice(-3).reduce((a,b)=>a+b,0)/3;
  f[7] = avgVol>0 ? Math.max(-1,Math.min(1,(recentVol/avgVol-1))) : 0;
  if(sig && sig.dir !== 0) f[8] = sig.dir*(sig.score/6);
  if(typeof marketCtx !== 'undefined' && marketCtx){
    if(marketCtx.bias==='long') f[9]=1; else if(marketCtx.bias==='short') f[9]=-1; else if(marketCtx.bias==='range') f[9]=0.3;
  }
  const last = k5[n-1]; const body = Math.abs(last.c-last.o); const range = (last.h-last.l)||1;
  const bodyRatio = body/range; const bullish = last.c>last.o;
  f[10] = bullish ? bodyRatio : -bodyRatio;
  let consec=0; for(let i=n-1;i>=Math.max(0,n-5);i--){if(k5[i].c>k5[i].o)consec++;else break;}
  let consecDown=0; for(let i=n-1;i>=Math.max(0,n-5);i--){if(k5[i].c<k5[i].o)consecDown++;else break;}
  f[11] = (consec-consecDown)/5;
  if(marketCtx && marketCtx.rangeH && marketCtx.rangeL){
    const rangeSize = marketCtx.rangeH - marketCtx.rangeL;
    if(rangeSize>0){const pos=(price-marketCtx.rangeL)/rangeSize;f[12]=(pos-0.5)*2;}
  }
  const regimeMap = {'TREND_UP':1,'TREND_DOWN':-1,'RANGE':0,'VOLATILE':-0.5,'QUIET':0.3};
  f[13] = regimeMap[regime]||0;
  return f;
}

