function renderEvoTab(stats){
  const vc=$('versionCards');
  if(vc){
    const cards=[
      {key:'ai',name:'🧠 AI Ensemble',cls:'v-ai'},
      {key:'momentum',name:'📈 Momentum',cls:'v-momentum'},
      {key:'pattern',name:'🕯 Pattern',cls:'v-pattern'}
    ];
    const allElo=Object.values(stats.elo);
    const minElo=Math.min(...allElo,1200);
    const maxElo=Math.max(...allElo,1800);
    const range=maxElo-minElo||1;
    vc.innerHTML=cards.map(c=>{
      const s=stats[c.key];
      const elo=stats.elo[c.key]||1500;
      const active=stats.active===c.key;
      const barW=((elo-minElo)/range)*100;
      const isBest = bestCfg.best && bestCfg.best.version === c.key;
      return '<div class="inner rounded-lg p-3 '+(active?'ring-2 ring-cyan-400':'')+' '+(isBest?'ring-2 ring-yellow-400':'')+'">'+
        '<div class="flex justify-between items-center mb-2">'+
        '<span class="text-[11px] font-bold text-purple-200">'+c.name+'</span>'+
        (active?'<span class="version-tag '+c.cls+'">ACTIVE</span>':'')+
        (isBest?'<span class="best-badge">🏆 BEST</span>':'')+
        '</div>'+
        '<div class="grid grid-cols-2 gap-2 text-[10px] mb-2">'+
        '<div><div class="text-gray-500">ELO</div><b class="text-amber-300">'+Math.round(elo)+'</b></div>'+
