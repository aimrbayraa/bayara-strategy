function openPos(sym,sig){
  if(!sig||S.positions.find(p=>p.sym===sym)) return;
  if(S.positions.length>=CFG.maxPos) return;
  if(S.bal<20||curDD()>=CFG.maxDD) return;
  if(!sig.entry||!sig.sl||!sig.tp1) return;

  if(CFG.autoApplyBest && bestCfg.best && bestCfg.autoApply){
    const applied = bestCfg.applyBest(evo);
    if(applied){
      log('🏆 Best config applied → confThr:'+evo.confThr.toFixed(3)+
          ' MFE×:'+evo.mfeMulti.toFixed(2)+' SL×:'+evo.slMulti.toFixed(2),
          'text-yellow-300');
    }
  }

  const entry=sig.entry, sl=sig.sl, tp1=sig.tp1;
  const tp2=sig.tp2||(sig.dir>0?entry+(tp1-entry)*2:entry-(entry-tp1)*2);
  const slD=Math.abs(entry-sl); if(slD<=0) return;
  const side=sig.dir>0?'LONG':'SHORT';
  const riskUsd=S.bal*(CFG.riskPct/100);
  const size=riskUsd/slD;
  const fee=size*entry*CFG.feeRate;
  S.bal-=fee; S.fees+=fee;
  const evoV = sig.evoVersion || evo.useVersion;

  const posEvoSnapshot = {
    sym,
    dir: sig.dir,
    entry,
    feat: sig.feat || (evo.lastPrediction ? evo.lastPrediction.feat : new Array(14).fill(0)),
    conf: sig.evoConf || 0.5,
    version: evoV,
    regime: sig.regime || currentRegime,
    tp1, tp2, sl
  };

  S.positions.push({
    sym, side, entry, size, sl, tp1, tp2, slD, fee, t:Date.now(),
    partial:false, be:false, name:sig.reason, score:sig.score,
    version: evoV, regime: sig.regime || currentRegime,
    mfe:0, mae:0,
    evoSnapshot: posEvoSnapshot
  });
  log('🎯 '+side+' '+sym+' @ '+fP(entry)+' ['+sig.reason+']','text-emerald-300');
  scheduleSave(); renderPos(); renderAnalytics();
}

function closePos(pos,exitPx,reason,partQty){
  const qty=partQty||pos.size;
  const pnlPU=pos.side==='LONG'?(exitPx-pos.entry):(pos.entry-exitPx);
  const gross=pnlPU*qty;
  const fee=qty*exitPx*CFG.feeRate;
  const net=gross-fee;
  const R=pnlPU/pos.slD;
  S.bal+=gross-fee; S.fees+=fee; S.pnl+=net;
  S.peak=Math.max(S.peak,S.bal); S.maxDD=Math.max(S.maxDD,curDD());
  S.n++;
  if(net>=0){S.w++;}else{S.l++;}
  S.hist.unshift({
    t:new Date().toLocaleTimeString().slice(0,8), sym:pos.sym, side:pos.side,
    e:pos.entry, c:exitPx, r:R, net, reason:partQty?'TP1':reason,
    v:pos.version||'—', regime:pos.regime||'—'
  });
  S.eqHist.push(S.bal);
  if(S.eqHist.length>500)S.eqHist.shift();

  if(!partQty){
    const evoTradeCtx = Object.assign({}, pos.evoSnapshot, {
      mfe: pos.mfe || 0,
      mae: pos.mae || 0
    });
    const res = evo.onClose(exitPx, evoTradeCtx);
    if(res && res.changed){
      log('🧬 ELO shift → '+res.useVersion.toUpperCase()+' (ELO '+Math.round(res.elo[res.useVersion])+')','text-fuchsia-300');
    }

    if(bestCfg.shouldEval(S.n)){
      const evalRes = bestCfg.evaluate(evo, S, currentRegime);
      if(evalRes){
        const sn = evalRes.snapshot;
        if(evalRes.newBest){
